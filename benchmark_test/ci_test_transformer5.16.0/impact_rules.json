{
  "version": 1,
  "always_tests": [
    "benchmark_test/ci_test_transformer5.16.0/test_ci_impact_selector.py"
  ],
  "frozen_patterns": [
    "xh_model_zoo/**",
    "xh_model_zoo_develop/**",
    "examples/**",
    "examples_develop/**",
    "configs/**"
  ],
  "documentation_patterns": [
    "docs/**",
    "*.md",
    "**/*.md",
    "*.rst",
    "**/*.rst",
    "LICENSE*",
    ".gitignore"
  ],
  "guarded_patterns": [
    "xhmodel_merak/**/*.py",
    "configs_merak/**/*.yaml",
    "configs_merak/**/*.yml",
    "examples_merak/**/*.py",
    "benchmark_test/**/*.py",
    "benchmark_test/**/*.sh"
  ],
  "full_suite_patterns": [
    "benchmark_test/ci_test_transformer5.16.0/run.sh",
    "benchmark_test/ci_test_transformer5.16.0/select_tests.py",
    "benchmark_test/ci_test_transformer5.16.0/impact_rules.json",
    "benchmark_test/ci_test_transformer5.16.0/conftest.py",
    "benchmark_test/ci_test_transformer5.16.0/pytest.ini",
    "xhmodel_merak/xh_llm/workflows/**",
    "xhmodel_merak/xh_llm/base_model.py",
    "xhmodel_merak/xh_llm/_dequant_converter.py",
    "pyproject.toml",
    "setup.py",
    "setup.cfg",
    "requirements*.txt"
  ],
  "rules": [
        {
            "id": "retired-ci-test-suite",
            "patterns": [
                "benchmark_test/ci_test/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_ci_impact_selector.py"
            ]
        },
        {
            "id": "retired-transformer55-suite",
            "patterns": [
                "benchmark_test/ci_test_transformer5.5.0/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_ci_impact_selector.py"
            ]
        },
        {
            "id": "transformer516-block-export-harness",
            "patterns": [
                "benchmark_test/ci_test_transformer5.16.0/_transformer516_block_export.py"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_qwen35_9b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_qwen35_35b_a3b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_e2b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_26b_a4b_block_export.py"
            ]
        },
        {
            "id": "allure-compat",
            "patterns": [
                "benchmark_test/ci_test_transformer5.16.0/_allure_compat.py"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_bge_reranker.py"
            ]
        },
        {
            "id": "qwen35-shared-source",
            "patterns": [
                "xhmodel_merak/xh_llm/models/qwen3_5/**",
                "examples_merak/llm/qwen3_5/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_qwen35_9b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_qwen35_35b_a3b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_transformer516_recipe_contract.py",
                "tests/qwen3_5/test_qwen35_quant_adapter.py",
                "tests/qwen3_5/test_qwen35_quant_dry_run_equivalence.py",
                "tests/qwen3_5/test_qwen35_workflow_quant_skip.py"
            ]
        },
        {
            "id": "qwen35-config-contract",
            "patterns": [
                "configs_merak/workflows/**/qwen3_5/**",
                "configs_merak/workflows/**/qwen3_5_moe/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_transformer516_recipe_contract.py",
                "tests/qwen3_5/test_qwen35_quant_adapter.py",
                "tests/qwen3_5/test_qwen35_quant_dry_run_equivalence.py",
                "tests/qwen3_5/test_qwen35_workflow_quant_skip.py"
            ]
        },
        {
            "id": "qwen35-9b-block",
            "patterns": [
                "configs_merak/workflows/**/qwen3_5/9b/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_qwen35_9b_block_export.py"
            ]
        },
        {
            "id": "qwen35-35b-a3b-block",
            "patterns": [
                "configs_merak/workflows/**/qwen3_5_moe/35b_a3b/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_qwen35_35b_a3b_block_export.py"
            ]
        },
        {
            "id": "gemma4-shared-source",
            "patterns": [
                "xhmodel_merak/xh_llm/models/gemma4_series/**",
                "examples_merak/llm/gemma4_series/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_e2b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_26b_a4b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_transformer516_recipe_contract.py",
                "tests/workflows_migration_test.py",
                "tests/gemma4/test_runtime_workflow_config_surface.py",
                "tests/gemma4/test_quant_result_contract.py"
            ]
        },
        {
            "id": "gemma4e-shared-source",
            "patterns": [
                "xhmodel_merak/xh_llm/models/gemma4e/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_e2b_block_export.py",
                "benchmark_test/ci_test_transformer5.16.0/test_transformer516_recipe_contract.py",
                "tests/workflows_migration_test.py",
                "tests/gemma4/test_runtime_workflow_config_surface.py",
                "tests/gemma4/test_quant_result_contract.py"
            ]
        },
        {
            "id": "gemma4-config-contract",
            "patterns": [
                "configs_merak/workflows/**/gemma4_series/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_transformer516_recipe_contract.py",
                "tests/workflows_migration_test.py",
                "tests/gemma4/test_runtime_workflow_config_surface.py",
                "tests/gemma4/test_quant_result_contract.py"
            ]
        },
        {
            "id": "gemma4-e2b-block",
            "patterns": [
                "configs_merak/workflows/**/gemma4_series/e2b/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_e2b_block_export.py"
            ]
        },
        {
            "id": "gemma4-26b-a4b-block",
            "patterns": [
                "configs_merak/workflows/**/gemma4_series/26b_a4b/**"
            ],
            "tests": [
                "benchmark_test/ci_test_transformer5.16.0/test_gemma4_26b_a4b_block_export.py"
            ]
        }
  ]
}
