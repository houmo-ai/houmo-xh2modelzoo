{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xh2modelzoo/schemas/merak_delivery_manifest.schema.json",
  "title": "Merak Delivery Manifest",
  "type": "object",
  "required": ["schema_version", "model_id", "version_id", "workflow", "artifacts", "quant", "export"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "model_id": {"type": "string"},
    "version_id": {"type": "string"},
    "workflow": {"type": "object"},
    "artifacts": {"type": "object"},
    "quant": {"type": "object"},
    "export": {"type": "object"},
    "evaluation": {"type": "object"}
  }
}
