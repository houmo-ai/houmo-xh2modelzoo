{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xh2modelzoo/schemas/merak_artifact_check.schema.json",
  "title": "Merak Artifact Check",
  "type": "object",
  "required": ["schema_version", "model_id", "version_id", "status", "checks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "model_id": {"type": "string"},
    "version_id": {"type": "string"},
    "status": {"type": "string", "enum": ["passed", "failed", "skipped"]},
    "checks": {"type": "array"}
  }
}
